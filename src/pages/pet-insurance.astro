---
// src/pages/pet-insurance.astro

const fullName = "علیرضا محمّدی جعفری";
const role = "دامپزشک و مشاور ایمنی غذایی";
const phone = "۰۹۰۲۵۴۷۲۹۲۹";
const email = "amojdvm@iran.ir";

const pageData = {
  title: "بیمه حیوانات خانگی در ورامین | مشاوره و ارائه بیمه سامان",
  description: "بیمه حیوانات خانگی در ورامین و شهرهای اطراف. دکتر جعفری با همکاری بیمه سامان، بهترین بیمه نامه‌های درمانی حیوانات خانگی را ارائه می‌دهد.",
  keywords: "بیمه حیوانات خانگی, بیمه حیوانات خانگی سامان, بیمه سگ, بیمه گربه, مشاوره بیمه حیوانات, بیمه درمانی حیوانات",
  canonical: "https://vet.hsc-co.ir/pet-insurance",
  heroBadge: "🛡️ بیمه حیوانات خانگی در ورامین",
  heroTitle: "بیمه حیوانات خانگی",
};
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageData.title}</title>
    <meta name="description" content={pageData.description} />
    <meta name="keywords" content={pageData.keywords} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={pageData.title} />
    <meta property="og:description" content={pageData.description} />
    <meta property="og:url" content={pageData.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <link rel="canonical" href={pageData.canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --primary: #0a4a6c;
        --primary-light: #e8f4fb;
        --primary-mid: #1a6a94;
        --primary-dark: #06344d;
        --secondary: #2ecc71;
        --secondary-dark: #27ae60;
        --gold: #f1c40f;
        --gold-bg: #fef9e7;
        --text: #132533;
        --text-mid: #3a5a6a;
        --text-muted: #6b7c8c;
        --bg: #f0f7fb;
        --surface: #ffffff;
        --shadow: 0 8px 32px rgba(10, 74, 108, 0.10);
        --shadow-hover: 0 16px 48px rgba(10, 74, 108, 0.16);
        --r-card: 24px;
        --r-pill: 50px;
        --transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      }
      html { scroll-behavior: smooth; }
      body {
        font-family: 'Vazirmatn', 'Tahoma', sans-serif;
        background: var(--bg);
        color: var(--text);
        direction: rtl;
        line-height: 1.75;
        padding: 20px;
        background-image:
          radial-gradient(circle at 10% 20%, rgba(10,74,108,0.04) 0%, transparent 40%),
          radial-gradient(circle at 90% 80%, rgba(46,204,113,0.04) 0%, transparent 40%);
      }
      .page { max-width: 920px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px; }
      .card {
        background: var(--surface);
        border-radius: var(--r-card);
        box-shadow: var(--shadow);
        padding: 32px 40px;
        border: 1px solid rgba(10, 74, 108, 0.06);
        animation: fadeUp 0.55s ease both;
        transition: var(--transition);
      }
      .card:hover { box-shadow: var(--shadow-hover); }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding: 20px 28px;
      }
      .logo-area {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .logo-icon {
        width: 52px;
        height: 52px;
        background: linear-gradient(145deg, var(--primary) 0%, var(--primary-mid) 100%);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: #fff;
        flex-shrink: 0;
        box-shadow: 0 6px 18px rgba(10,74,108,0.25);
      }
      .logo-text {
        font-size: 19px;
        font-weight: 800;
        color: var(--primary);
        letter-spacing: -0.3px;
      }
      .contact-badge {
        display: flex;
        align-items: center;
        gap: 18px;
        font-size: 14px;
        color: var(--text-mid);
      }
      .contact-badge a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 700;
        transition: var(--transition);
        padding: 6px 12px;
        border-radius: 10px;
      }
      .contact-badge a:hover {
        background: var(--primary-light);
        color: var(--primary-dark);
      }
      .hero {
        text-align: center;
        position: relative;
        overflow: hidden;
        padding: 48px 40px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fcff 100%);
      }
      .hero .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--gold-bg);
        color: #9a7b0a;
        border: 1px solid #f5e6a3;
        padding: 7px 22px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 20px;
        box-shadow: 0 2px 10px rgba(241,196,15,0.15);
      }
      .hero h1 {
        font-size: 34px;
        font-weight: 900;
        color: var(--text);
        line-height: 1.4;
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
      }
      .hero h1 .highlight {
        color: var(--primary);
        position: relative;
      }
      .hero h1 .highlight::after {
        content: '';
        position: absolute;
        bottom: 3px;
        right: 0;
        left: 0;
        height: 5px;
        background: linear-gradient(90deg, var(--gold), #f39c12);
        border-radius: 3px;
        opacity: 0.85;
      }
      .hero p {
        font-size:17px;
        color:var(--text-mid);
        max-width:650px;
        margin:0 auto;
        line-height:2;
      }
      .cta-group {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 14px;
        position: relative;
        z-index: 1;
        margin-top: 20px;
      }
      .btn-primary {
        background: linear-gradient(145deg, var(--primary) 0%, var(--primary-mid) 100%);
        color: #fff;
        padding: 15px 38px;
        border: none;
        border-radius: var(--r-pill);
        font-size: 17px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 24px rgba(10,74,108,.28);
      }
      .btn-primary:hover {
        background: linear-gradient(145deg, var(--primary-dark) 0%, var(--primary) 100%);
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(10,74,108,.38);
      }
      .btn-secondary {
        background: linear-gradient(145deg, var(--secondary) 0%, var(--secondary-dark) 100%);
        color: #fff;
        padding: 15px 38px;
        border: none;
        border-radius: var(--r-pill);
        font-size: 17px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 8px 24px rgba(46,204,113,.28);
      }
      .btn-secondary:hover {
        background: linear-gradient(145deg, #219a52 0%, var(--secondary-dark) 100%);
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(46,204,113,.38);
      }
      .section-label {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 0.6px;
        text-transform: uppercase;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .section-label::after {
        content: '';
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, var(--primary-light), transparent);
      }
      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }
      .grid-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
      }
      .card-item {
        background: var(--primary-light);
        border-radius: 18px;
        padding: 24px 20px;
        transition: var(--transition);
        border-right: 4px solid var(--primary);
        text-align: center;
      }
      .card-item:hover {
        background: linear-gradient(160deg, var(--primary) 0%, var(--primary-mid) 100%);
        color: #fff;
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(10,74,108,.22);
      }
      .card-item .icon {
        font-size: 32px;
        display: block;
        margin-bottom: 8px;
      }
      .card-item h3 {
        font-size: 16px;
        margin-bottom: 6px;
      }
      .card-item p {
        font-size: 14px;
        opacity: 0.85;
        line-height: 1.6;
      }
      .card-item:hover h3,
      .card-item:hover p { color: #fff; }
      .gold-box {
        background: var(--gold-bg);
        border-radius: 20px;
        padding: 28px 30px;
        border-right: 5px solid var(--gold);
        margin: 16px 0;
      }
      .gold-box h3 {
        color: var(--primary);
        font-size: 18px;
        margin-bottom: 12px;
      }
      .gold-box ul {
        list-style: none;
        padding: 0;
      }
      .gold-box ul li {
        padding: 8px 0;
        border-bottom: 1px solid rgba(10,74,108,0.06);
        font-size: 14.5px;
        padding-right: 28px;
        position: relative;
      }
      .gold-box ul li::before {
        content: "✓";
        color: var(--secondary);
        font-weight: 700;
        position: absolute;
        right: 0;
      }
      .gold-box ul li:last-child {
        border-bottom: none;
      }
      .step-box {
        background: white;
        border-radius: 16px;
        padding: 20px 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        text-align: center;
        border: 1px solid var(--primary-light);
      }
      .step-box .num {
        background: var(--primary);
        color: white;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px auto;
        font-weight: 700;
        font-size: 16px;
      }
      .step-box h4 {
        font-size: 15px;
        color: var(--text);
        margin-bottom: 4px;
      }
      .step-box p {
        font-size: 13px;
        color: var(--text-mid);
        line-height: 1.6;
        margin: 0;
      }
      .faq-item {
        background: var(--bg);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 12px;
      }
      .faq-item strong {
        color: var(--primary);
      }
      .faq-item p {
        font-size: 14px;
        color: var(--text-mid);
        margin: 4px 0 0 0;
      }
      .footer {
        text-align: center;
        font-size: 13.5px;
        color: var(--text-muted);
        border-top: 1px solid var(--primary-light);
        padding-top: 24px;
        margin-top: 4px;
      }
      .footer a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 600;
      }
      .footer .socials {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
      }
      .footer .socials a {
        font-size: 13.5px;
        padding: 7px 16px;
        border-radius: 24px;
        background: var(--primary-light);
        color: var(--primary);
        transition: var(--transition);
        font-weight: 600;
      }
      .footer .socials a:hover {
        background: var(--primary);
        color: #fff;
        transform: translateY(-2px);
      }
      .fab-call {
        position: fixed;
        bottom: 28px;
        left: 28px;
        width: 60px;
        height: 60px;
        background: linear-gradient(145deg, var(--secondary) 0%, var(--secondary-dark) 100%);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        box-shadow: 0 8px 28px rgba(46,204,113,0.4);
        text-decoration: none;
        z-index: 100;
        transition: var(--transition);
        animation: pulse 2.5s infinite;
      }
      .fab-call:hover {
        transform: scale(1.1);
        box-shadow: 0 12px 36px rgba(46,204,113,0.5);
      }
      @keyframes pulse {
        0%, 100% { box-shadow: 0 8px 28px rgba(46,204,113,0.4); }
        50% { box-shadow: 0 8px 28px rgba(46,204,113,0.4), 0 0 0 14px rgba(46,204,113,0.15); }
      }
      .form-group {
        margin-bottom: 16px;
      }
      .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: rgba(255,255,255,0.9);
        margin-bottom: 6px;
      }
      .form-group input,
      .form-group select,
      .form-group textarea {
        width: 100%;
        padding: 14px 18px;
        border: none;
        border-radius: 14px;
        font-size: 15px;
        font-family: inherit;
        background: rgba(255,255,255,0.95);
        color: var(--text);
        transition: var(--transition);
      }
      .form-group input:focus,
      .form-group textarea:focus {
        outline: none;
        background: #fff;
        box-shadow: 0 0 0 4px rgba(255,255,255,0.3);
      }
      .form-group textarea {
        resize: vertical;
        min-height: 90px;
      }
      .btn-submit {
        width: 100%;
        padding: 16px;
        background: linear-gradient(145deg, var(--secondary) 0%, var(--secondary-dark) 100%);
        color: #fff;
        border: none;
        border-radius: var(--r-pill);
        font-size: 17px;
        font-weight: 700;
        font-family: inherit;
        cursor: pointer;
        transition: var(--transition);
        margin-top: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 6px 20px rgba(46,204,113,0.3);
      }
      .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(46,204,113,.4);
      }
      .btn-submit:disabled {
        opacity: 0.65;
        cursor: not-allowed;
        transform: none;
      }
      .form-status {
        display: none;
        margin-top: 16px;
        padding: 14px 18px;
        border-radius: 14px;
        font-size: 14.5px;
        font-weight: 500;
        text-align: center;
        background: rgba(255,255,255,0.15);
        color: #fff;
      }
      .form-status.success {
        display: block;
        background: rgba(46,204,113,0.3);
        color: #d5f5e3;
      }
      .form-status.error {
        display: block;
        background: rgba(231,76,60,0.3);
        color: #fadbd8;
      }
      @media (max-width: 700px) {
        body { padding: 14px; }
        .card { padding: 20px 16px; }
        .hero { padding: 28px 16px; }
        .hero h1 { font-size: 24px; }
        .grid-2 { grid-template-columns: 1fr; }
        .grid-3 { grid-template-columns: 1fr; }
        .header { flex-direction: column; text-align: center; }
        .logo-area { justify-content: center; }
        .contact-badge { justify-content: center; flex-wrap: wrap; }
        .btn-primary, .btn-secondary { width: 100%; justify-content: center; }
        .fab-call { bottom: 20px; left: 20px; width: 56px; height: 56px; font-size: 22px; }
        .gold-box { padding: 20px 18px; }
      }
      @media (max-width: 450px) {
        .hero h1 { font-size: 20px; }
        .logo-text { font-size: 16px; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <!-- HEADER -->
      <header class="card header">
        <div class="logo-area">
          <div class="logo-icon" aria-hidden="true">🐾</div>
          <span class="logo-text">{fullName}</span>
        </div>
        <div class="contact-badge">
          <span>📞 <a href={`tel:${phone}`}>{phone}</a></span>
          <span>✉️ <a href={`mailto:${email}`}>{email}</a></span>
        </div>
      </header>

      <!-- HERO -->
      <section class="card hero">
        <span class="badge">{pageData.heroBadge}</span>
        <h1>
          <span class="highlight">{pageData.heroTitle}</span><br />
          با همکاری بیمه سامان
        </h1>
        <p>
          با بیمه کردن حیوان خانگی خود، هزینه‌های درمانی، جراحی و بستری را پوشش دهید. 
          <strong>مشاوره رایگان</strong> و بهترین پوشش‌های بیمه‌ای در ورامین و شهرهای اطراف.
        </p>
        <div class="cta-group">
          <a href="#consult" class="btn-primary">📋 دریافت مشاوره بیمه</a>
          <a href="tel:09025472929" class="btn-secondary">📞 تماس فوری</a>
        </div>
      </section>

      <!-- مزایا -->
      <section class="card">
        <div class="section-label">✨ مزایای بیمه حیوانات خانگی</div>
        <div class="grid-3">
          <div class="step-box">
            <div class="num">۱</div>
            <h4>پوشش هزینه‌های درمانی</h4>
            <p>بیمه تا سقف مشخص، هزینه‌های درمان بیماری‌ها و حوادث را پوشش می‌دهد</p>
          </div>
          <div class="step-box">
            <div class="num">۲</div>
            <h4>پوشش جراحی و بستری</h4>
            <p>هزینه‌های جراحی، بستری و خدمات پاراکلینیکی تحت پوشش قرار می‌گیرد</p>
          </div>
          <div class="step-box">
            <div class="num">۳</div>
            <h4>پوشش واکسیناسیون</h4>
            <p>هزینه واکسیناسیون سالانه حیوان خانگی نیز تحت پوشش بیمه است</p>
          </div>
        </div>
      </section>

      <!-- پوشش‌ها -->
      <section class="card">
        <div class="section-label">🛡️ پوشش‌های بیمه حیوانات خانگی</div>
        <div class="gold-box">
          <h3>بیمه درمانی حیوانات خانگی (بیمه سامان)</h3>
          <ul>
            <li><strong>پوشش هزینه‌های درمانی</strong> — بیماری‌های داخلی، عفونی، پوستی، چشمی و...</li>
            <li><strong>پوشش هزینه‌های جراحی</strong> — جراحی‌های عمومی، ارتوپدی، عقیم‌سازی و...</li>
            <li><strong>پوشش هزینه‌های تشخیصی</strong> — آزمایشات خون، ادرار، تصویربرداری، سونوگرافی</li>
            <li><strong>پوشش هزینه‌های بستری</strong> — بستری در بیمارستان و مراقبت‌های ویژه</li>
            <li><strong>پوشش هزینه‌های واکسیناسیون</strong> — واکسن‌های سالانه و ضروری</li>
            <li><strong>پوشش هزینه‌های دارویی</strong> — داروهای تجویزی مورد نیاز حیوان</li>
          </ul>
        </div>
      </section>

      <!-- مراحل دریافت بیمه -->
      <section class="card">
        <div class="section-label">📋 مراحل دریافت بیمه حیوانات خانگی</div>
        <div class="grid-3">
          <div class="step-box">
            <div class="num">۱</div>
            <h4>مشاوره رایگان</h4>
            <p>با دکتر جعفری تماس بگیرید و از شرایط بیمه مطلع شوید</p>
          </div>
          <div class="step-box">
            <div class="num">۲</div>
            <h4>معاینه حیوان</h4>
            <p>معاینه کامل حیوان و تکمیل فرم سلامت توسط دامپزشک</p>
          </div>
          <div class="step-box">
            <div class="num">۳</div>
            <h4>صدور بیمه نامه</h4>
            <p>صدور بیمه نامه و ارائه مدارک به صاحب حیوان</p>
          </div>
        </div>
      </section>

      <!-- مدارک مورد نیاز -->
      <section class="card">
        <div class="section-label">📄 مدارک مورد نیاز</div>
        <div style="background:var(--bg); border-radius:16px; padding:20px 24px;">
          <ul style="list-style:none; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <li style="display:flex; align-items:center; gap:10px; padding:8px 12px; background:white; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
              <span style="color:var(--secondary); font-size:18px;">✓</span>
              <span>کارت واکسیناسیون حیوان</span>
            </li>
            <li style="display:flex; align-items:center; gap:10px; padding:8px 12px; background:white; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,0.04);">
              <span style="color:var(--secondary); font-size:18px;">✓</span>
              <span>مدارک شناسایی صاحب حیوان</span>
            </li>
