---
// src/pages/posts/[slug].astro
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = "https://news-daily-e3a.pages.dev";
const postUrl = `${siteUrl}/posts/${post.id}`;

// مقالات مرتبط بر اساس تگ‌های مشترک
const allPosts = await getCollection('posts');
const related = allPosts
  .filter((p) => p.slug !== post.id && p.data.tags.some((t) => post.data.tags.includes(t)))
  .slice(0, 3);
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} | وبلاگ من</title>
    <meta name="description" content={post.data.excerpt} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={postUrl} />
    <meta property="og:title" content={post.data.title} />
    <meta property="og:description" content={post.data.excerpt} />
    <meta property="og:url" content={postUrl} />
    <meta property="og:type" content="article" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <style>
      :root {
        --primary: #4f46e5;
        --bg: #f8fafc;
        --bg-card: #ffffff;
        --bg-tag: #eef2ff;
        --text: #0f172a;
        --text-body: #1e293b;
        --text-muted: #64748b;
        --text-tag: #4f46e5;
        --border: #e2e8f0;
        --shadow: 0 2px 16px rgba(0,0,0,0.06);
        --radius: 14px;
        --transition: all 0.25s ease;
      }
      html.dark {
        --bg: #0f172a;
        --bg-card: #1e293b;
        --bg-tag: #312e81;
        --text: #f1f5f9;
        --text-body: #cbd5e1;
        --text-muted: #94a3b8;
        --text-tag: #a5b4fc;
        --border: #334155;
        --shadow: 0 2px 16px rgba(0,0,0,0.35);
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Vazirmatn', 'Tahoma', system-ui, sans-serif;
        background: var(--bg); color: var(--text);
        line-height: 1.8; padding: 0 20px;
        transition: background 0.3s, color 0.3s;
      }

      /* نوار پیشرفت مطالعه */
      #progress-bar {
        position: fixed; top: 0; right: 0; height: 3px; width: 0%;
        background: linear-gradient(90deg, var(--primary), #7c3aed);
        z-index: 1000; transition: width 0.1s linear;
      }

      .container { max-width: 820px; margin: 0 auto; padding: 30px 0 60px; }

      .top-nav {
        display: flex; justify-content: space-between;
        align-items: center; margin-bottom: 28px;
      }
      .back-link {
        display: inline-flex; align-items: center; gap: 6px;
        color: var(--primary); text-decoration: none;
        font-weight: 600; font-size: 0.9rem; transition: var(--transition);
      }
      .back-link:hover { gap: 10px; }
      .dark-toggle {
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: 50px; padding: 6px 14px; cursor: pointer;
        font-size: 1rem; color: var(--text); font-family: inherit;
        transition: var(--transition);
      }
      .dark-toggle:hover { border-color: var(--primary); }

      /* هدر مقاله */
      .article-header {
        background: var(--bg-card); border-radius: var(--radius);
        padding: 36px 40px; box-shadow: var(--shadow);
        margin-bottom: 20px; border: 1px solid var(--border);
      }
      .article-header h1 {
        font-size: clamp(1.5rem, 4vw, 2.2rem); font-weight: 800;
        color: var(--text); margin-bottom: 18px; line-height: 1.4;
      }
      .meta-row { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; }
      .meta-item {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 0.85rem; color: var(--text-muted);
        background: var(--bg); padding: 4px 14px;
        border-radius: 20px; border: 1px solid var(--border);
      }
      .tag-group { display: flex; flex-wrap: wrap; gap: 6px; }
      .tag {
        font-size: 0.78rem; font-weight: 600; background: var(--bg-tag);
        color: var(--text-tag); padding: 4px 13px; border-radius: 20px;
      }

      /* محتوای مقاله — Astro <Content /> را استایل می‌دهیم */
      .article-body {
        background: var(--bg-card); border-radius: var(--radius);
        padding: 40px; box-shadow: var(--shadow);
        border: 1px solid var(--border); margin-bottom: 20px;
      }
      .article-body :global(p) {
        font-size: 1.08rem; color: var(--text-body);
        line-height: 2.1; margin-bottom: 22px;
      }
      .article-body :global(h2) {
        font-size: 1.4rem; font-weight: 700; color: var(--text);
        margin: 32px 0 14px; padding-right: 14px;
        border-right: 3px solid var(--primary); line-height: 1.4;
      }
      .article-body :global(h3) {
        font-size: 1.15rem; font-weight: 700; color: var(--text);
        margin: 24px 0 10px;
      }
      .article-body :global(strong) { color: var(--text); font-weight: 700; }
      .article-body :global(ul),
      .article-body :global(ol) {
        padding-right: 24px; margin-bottom: 22px; color: var(--text-body);
        font-size: 1.05rem; line-height: 2;
      }
      .article-body :global(li) { margin-bottom: 6px; }
      .article-body :global(a) {
        color: var(--primary); text-decoration: underline;
        text-underline-offset: 3px;
      }
      .article-body :global(code) {
        background: var(--bg); border: 1px solid var(--border);
        padding: 2px 8px; border-radius: 6px;
        font-size: 0.9em; direction: ltr; display: inline-block;
      }
      .article-body :global(pre) {
        background: var(--bg); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 20px;
        overflow-x: auto; margin-bottom: 22px; direction: ltr;
      }
      .article-body :global(pre code) {
        background: none; border: none; padding: 0;
      }
      .article-body :global(blockquote) {
        border-right: 3px solid var(--primary);
        padding: 12px 20px; margin: 0 0 22px;
        background: var(--bg); border-radius: 0 var(--radius) var(--radius) 0;
        color: var(--text-muted); font-style: italic;
      }

      /* دکمه اشتراک‌گذاری */
      .share-bar {
        display: flex; align-items: center; gap: 12px;
        margin-bottom: 32px; flex-wrap: wrap;
      }
      .share-label { font-size: 0.9rem; color: var(--text-muted); }
      .share-btn {
        background: var(--bg-card); border: 1.5px solid var(--border);
        color: var(--text); padding: 7px 20px; border-radius: 50px;
        font-size: 0.85rem; font-weight: 600; cursor: pointer;
        font-family: inherit; transition: var(--transition);
        display: flex; align-items: center; gap: 6px;
      }
      .share-btn:hover { border-color: var(--primary); color: var(--primary); }
      .share-btn.copied { border-color: #10b981; color: #10b981; }

      /* مقالات مرتبط */
      .related-section h2 {
        font-size: 1.2rem; font-weight: 700;
        margin-bottom: 16px; color: var(--text);
      }
      .related-grid { display: flex; flex-direction: column; gap: 12px; }
      .related-card {
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: var(--radius); padding: 20px 24px;
        text-decoration: none; display: block;
        transition: var(--transition); box-shadow: var(--shadow);
      }
      .related-card:hover { transform: translateX(-3px); border-color: var(--primary); }
      .related-card h3 { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 6px; }
      .related-card:hover h3 { color: var(--primary); }
      .related-card p { font-size: 0.86rem; color: var(--text-muted); line-height: 1.6; }
      .related-meta {
        display: flex; align-items: center; gap: 10px;
        margin-top: 10px; font-size: 0.8rem; color: var(--text-muted);
      }

      .post-footer {
        margin-top: 48px; text-align: center; padding-top: 24px;
        border-top: 1px solid var(--border); color: var(--text-muted); font-size: 0.88rem;
      }

      @media (max-width: 640px) {
        .article-header { padding: 22px 18px; }
        .article-body { padding: 22px 18px; }
        .meta-row { flex-direction: column; align-items: flex-start; }
      }
    </style>
  </head>

  <body>
    <div id="progress-bar"></div>

    <div class="container">
      <nav class="top-nav">
        <a href="/" class="back-link">← بازگشت به مقالات</a>
        <button class="dark-toggle" id="darkToggle" aria-label="تغییر تم">
          <span id="themeIcon">🌙</span>
        </button>
      </nav>

      <article>
        <div class="article-header">
          <h1>{post.data.title}</h1>
          <div class="meta-row">
            <span class="meta-item">📅 {post.data.date}</span>
            <span class="meta-item">⏱ {post.data.readingTime} دقیقه مطالعه</span>
            <div class="tag-group">
              {post.data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          </div>
        </div>

        <!-- Astro خودکار Markdown را به HTML تبدیل می‌کند -->
        <div class="article-body" id="article-content">
          <Content />
        </div>
      </article>

      <div class="share-bar">
        <span class="share-label">اشتراک‌گذاری:</span>
        <button class="share-btn" id="copyBtn">🔗 کپی لینک</button>
      </div>

      {related.length > 0 && (
        <section class="related-section">
          <h2>📖 مقالات مرتبط</h2>
          <div class="related-grid">
            {related.map((rel) => (
              <a href={`/posts/${rel.id}`} class="related-card">
                <h3>{rel.data.title}</h3>
                <p>{rel.data.excerpt}</p>
                <div class="related-meta">
                  <span>📅 {rel.data.date}</span>
                  <span>⏱ {rel.data.readingTime} دقیقه</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <footer class="post-footer">
        <p>© {new Date().getFullYear()} تمامی حقوق محفوظ است</p>
      </footer>
    </div>

    <script is:inline>
      // Dark Mode
      const html = document.documentElement;
      const toggle = document.getElementById('darkToggle');
      const icon = document.getElementById('themeIcon');
      function updateUI() { icon.textContent = html.classList.contains('dark') ? '☀️' : '🌙'; }
      updateUI();
      toggle.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        updateUI();
      });

      // نوار پیشرفت
      const bar = document.getElementById('progress-bar');
      const content = document.getElementById('article-content');
      window.addEventListener('scroll', () => {
        const rect = content.getBoundingClientRect();
        const pct = Math.min(Math.max((-rect.top / (rect.height - window.innerHeight)) * 100, 0), 100);
        bar.style.width = pct + '%';
      }, { passive: true });

      // کپی لینک
      document.getElementById('copyBtn').addEventListener('click', function () {
        navigator.clipboard.writeText(window.location.href).then(() => {
          this.textContent = '✅ لینک کپی شد!';
          this.classList.add('copied');
          setTimeout(() => { this.innerHTML = '🔗 کپی لینک'; this.classList.remove('copied'); }, 2500);
        });
      });
    </script>
  </body>
</html>