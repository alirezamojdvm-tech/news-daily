---
// src/pages/posts/[id].astro
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const blogDir = path.resolve(__dirname, '../../content/blog');

// --- تابع برای خواندن فایل‌های Markdown و استخراج frontmatter و محتوا ---
function getArticleData(slug) {
  try {
    const filePath = path.join(blogDir, `${slug}.md`);
    if (!fs.existsSync(filePath)) return null;
    
    const content = fs.readFileSync(filePath, 'utf8');
    const lines = content.split('\n');
    let frontmatter = {};
    let body = '';
    let isFrontmatter = false;
    let frontmatterEnded = false;
    let currentKey = '';
    let currentValue = '';
    
    for (const line of lines) {
      if (line.trim() === '---') {
        if (!isFrontmatter) {
          isFrontmatter = true;
          continue;
        } else {
          frontmatterEnded = true;
          isFrontmatter = false;
          continue;
        }
      }
      
      if (isFrontmatter) {
        const match = line.match(/^(\w+):\s*(.*)$/);
        if (match) {
          if (currentKey) {
            frontmatter[currentKey] = currentValue.trim();
          }
          currentKey = match[1];
          currentValue = match[2];
        } else if (currentKey) {
          currentValue += ' ' + line.trim();
        }
      } else if (frontmatterEnded) {
        body += line + '\n';
      }
    }
    
    if (currentKey) {
      frontmatter[currentKey] = currentValue.trim();
    }
    
    // پردازش tags اگر به صورت رشته باشد
    if (frontmatter.tags && typeof frontmatter.tags === 'string') {
      frontmatter.tags = frontmatter.tags.replace(/[\[\]"]/g, '').split(',').map(t => t.trim());
    }
    
    return {
      ...frontmatter,
      id: parseInt(slug),
      content: body.trim()
    };
  } catch (error) {
    console.error(`❌ خطا در خواندن فایل ${slug}.md:`, error);
    return null;
  }
}

// --- تابع getStaticPaths برای تولید صفحات ---
export async function getStaticPaths() {
  try {
    const files = fs.readdirSync(blogDir);
    const mdFiles = files.filter(file => file.endsWith('.md'));
    
    return mdFiles.map((file) => {
      const slug = file.replace('.md', '');
      return {
        params: { id: slug },
        props: { slug }
      };
    });
  } catch (error) {
    console.error('❌ خطا در خواندن پوشه مقالات:', error);
    return [];
  }
}

// --- دریافت props مقاله جاری ---
const { slug } = Astro.props;
const article = getArticleData(slug);

if (!article) {
  return Astro.redirect('/');
}
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{article.title} | وبلاگ من</title>
    <meta name="description" content={article.excerpt} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`https://news-daily-e3a.pages.dev/posts/${slug}`} />
    
    <meta property="og:title" content={article.title} />
    <meta property="og:description" content={article.excerpt} />
    <meta property="og:url" content={`https://news-daily-e3a.pages.dev/posts/${slug}`} />
    <meta property="og:type" content="article" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={article.title} />
    <meta name="twitter:description" content={article.excerpt} />
    
    <style>
      /* استایل‌های مشابه قبل */
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Vazir', 'Tahoma', system-ui, sans-serif;
        background: #f8fafc;
        color: #0f172a;
        line-height: 1.8;
        padding: 0 20px;
      }
      .container { max-width: 820px; margin: 0 auto; padding: 30px 0 50px; }
      .back-link {
        display: inline-block;
        margin-bottom: 20px;
        color: #4f46e5;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s;
      }
      .back-link:hover { color: #4338ca; transform: translateX(-5px); }
      .article-header {
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 20px;
        margin-bottom: 30px;
      }
      .article-header h1 { font-size: 2.2rem; font-weight: 800; color: #0f172a; margin-bottom: 10px; }
      .article-header .meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        color: #64748b;
        font-size: 0.9rem;
      }
      .article-header .tags { display: flex; flex-wrap: wrap; gap: 6px; }
      .article-header .tag {
        background: #eef2ff;
        color: #4f46e5;
        padding: 2px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
      }
      .article-content { font-size: 1.1rem; color: #1e293b; line-height: 2; }
      .article-content p { margin-bottom: 20px; }
      .article-content h2 { font-size: 1.6rem; margin: 30px 0 15px; color: #0f172a; }
      .article-content h3 { font-size: 1.3rem; margin: 25px 0 10px; color: #1e293b; }
      .article-footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
        text-align: center;
        color: #94a3b8;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="/" class="back-link">← بازگشت به لیست مقالات</a>
      
      <article>
        <div class="article-header">
          <h1>{article.title}</h1>
          <div class="meta">
            <span>📅 {article.date}</span>
            <div class="tags">
              {article.tags?.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          </div>
        </div>
        
        <div class="article-content">
          {article.content.split('\n').map((paragraph, index) => (
            paragraph.trim() ? <p>{paragraph}</p> : null
          ))}
        </div>
      </article>
      
      <div class="article-footer">
        <p>© {new Date().getFullYear()} تمامی حقوق محفوظ است</p>
      </div>
    </div>
  </body>
</html>