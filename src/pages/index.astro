---
// src/pages/index.astro
import { getCollection } from 'astro:content';

const siteTitle = "وبلاگ علیرضا محمّدی جعفری";
const siteDescription = "مقالات آموزشی درباره سئو، دیجیتال مارکتینگ و توسعه وب";
const siteUrl = "https://news-daily-e3a.pages.dev";
const authorName = "علیرضا محمّدی جعفری";

// ← دیگه articles.js نیست؛ همه چیز از فایل‌های Markdown میاد
const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.id.localeCompare(a.id));
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={siteUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <style>
      :root {
        --primary: #4f46e5;
        --bg: #f8fafc;
        --bg-card: #ffffff;
        --bg-tag: #eef2ff;
        --text: #0f172a;
        --text-muted: #64748b;
        --text-tag: #4f46e5;
        --border: #e2e8f0;
        --shadow: 0 2px 16px rgba(0,0,0,0.06);
        --shadow-hover: 0 8px 32px rgba(79,70,229,0.12);
        --radius: 14px;
        --transition: all 0.25s ease;
      }
      html.dark {
        --bg: #0f172a;
        --bg-card: #1e293b;
        --bg-tag: #312e81;
        --text: #f1f5f9;
        --text-muted: #94a3b8;
        --text-tag: #a5b4fc;
        --border: #334155;
        --shadow: 0 2px 16px rgba(0,0,0,0.3);
        --shadow-hover: 0 8px 32px rgba(79,70,229,0.25);
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Vazirmatn', 'Tahoma', system-ui, sans-serif;
        background: var(--bg); color: var(--text);
        line-height: 1.8; padding: 0 20px;
        transition: background 0.3s, color 0.3s;
      }
      .container { max-width: 840px; margin: 0 auto; padding: 30px 0 60px; }

      /* Header */
      .site-header {
        display: flex; flex-direction: column; align-items: center;
        text-align: center; padding: 48px 0 32px;
        border-bottom: 1px solid var(--border); margin-bottom: 36px;
      }
      .header-top { width: 100%; display: flex; justify-content: flex-start; margin-bottom: 24px; }
      .dark-toggle {
        background: var(--bg-card); border: 1px solid var(--border);
        border-radius: 50px; padding: 6px 14px; cursor: pointer;
        font-size: 1rem; color: var(--text); font-family: inherit;
        transition: var(--transition); display: flex; align-items: center; gap: 6px;
      }
      .dark-toggle:hover { border-color: var(--primary); }
      .toggle-label { font-size: 0.8rem; color: var(--text-muted); }
      .site-header h1 {
        font-size: clamp(2rem, 5vw, 2.8rem); font-weight: 800;
        background: linear-gradient(135deg, var(--primary), #7c3aed);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text; margin-bottom: 8px;
      }
      .site-header .subtitle { color: var(--text-muted); font-size: 1rem; max-width: 500px; }

      /* Controls */
      .controls { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
      .search-wrap { position: relative; }
      .search-icon {
        position: absolute; right: 16px; top: 50%; transform: translateY(-50%);
        color: var(--text-muted); pointer-events: none;
      }
      #search {
        width: 100%; padding: 13px 44px 13px 18px;
        border: 1.5px solid var(--border); border-radius: var(--radius);
        background: var(--bg-card); color: var(--text);
        font-size: 1rem; font-family: inherit; outline: none; transition: var(--transition);
      }
      #search:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(79,70,229,0.12); }
      #search::placeholder { color: var(--text-muted); }
      .tag-filters { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
      .filter-label { font-size: 0.85rem; color: var(--text-muted); margin-left: 4px; }
      .tag-btn {
        background: var(--bg-card); border: 1.5px solid var(--border);
        color: var(--text-muted); padding: 5px 16px; border-radius: 50px;
        font-size: 0.82rem; font-weight: 500; cursor: pointer;
        font-family: inherit; transition: var(--transition);
      }
      .tag-btn:hover { border-color: var(--primary); color: var(--primary); }
      .tag-btn.active { background: var(--primary); border-color: var(--primary); color: white; }

      .results-info { font-size: 0.88rem; color: var(--text-muted); margin-bottom: 20px; }
      .results-info span { color: var(--primary); font-weight: 600; }

      /* Cards */
      .articles-grid { display: flex; flex-direction: column; gap: 24px; }
      .article-card {
        background: var(--bg-card); border-radius: var(--radius);
        padding: 28px 32px; box-shadow: var(--shadow);
        border: 1px solid transparent; transition: var(--transition);
        animation: fadeUp 0.4s ease both;
      }
      .article-card:hover {
        transform: translateY(-3px); box-shadow: var(--shadow-hover);
        border-color: var(--border);
      }
      .article-card.hidden { display: none; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .card-meta {
        display: flex; justify-content: space-between;
        align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 14px;
      }
      .card-meta-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .date {
        font-size: 0.82rem; color: var(--text-muted);
        background: var(--bg); padding: 3px 12px;
        border-radius: 20px; border: 1px solid var(--border);
      }
      .reading-time { font-size: 0.8rem; color: var(--text-muted); }
      .tag-group { display: flex; flex-wrap: wrap; gap: 6px; }
      .tag {
        font-size: 0.76rem; font-weight: 600; background: var(--bg-tag);
        color: var(--text-tag); padding: 3px 12px; border-radius: 20px;
        cursor: pointer; border: none; font-family: inherit; transition: var(--transition);
      }
      .tag:hover { opacity: 0.75; }
      .article-card h2 {
        font-size: clamp(1.2rem, 3vw, 1.55rem);
        font-weight: 700; margin: 0 0 10px; line-height: 1.4;
      }
      .article-card h2 a {
        text-decoration: none; color: var(--text); transition: var(--transition);
      }
      .article-card h2 a:hover { color: var(--primary); }
      .excerpt { color: var(--text-muted); font-size: 0.97rem; margin-bottom: 18px; line-height: 1.9; }
      .read-more {
        display: inline-flex; align-items: center; gap: 6px;
        font-weight: 600; font-size: 0.9rem; color: var(--primary);
        text-decoration: none; transition: var(--transition);
        border-bottom: 1px solid transparent;
      }
      .read-more:hover { gap: 10px; border-bottom-color: var(--primary); }

      .empty-state {
        text-align: center; padding: 60px 20px;
        color: var(--text-muted); display: none;
      }
      .empty-state .icon { font-size: 3rem; margin-bottom: 12px; }

      .site-footer {
        margin-top: 60px; text-align: center; padding-top: 24px;
        border-top: 1px solid var(--border); color: var(--text-muted);
        font-size: 0.88rem; line-height: 2;
      }
      @media (max-width: 640px) {
        .article-card { padding: 20px 18px; }
        .card-meta { flex-direction: column; align-items: flex-start; }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <header class="site-header">
        <div class="header-top">
          <button class="dark-toggle" id="darkToggle" aria-label="تغییر تم">
            <span id="themeIcon">🌙</span>
            <span class="toggle-label" id="themeLabel">تم تاریک</span>
          </button>
        </div>
        <h1>✍️ وبلاگ من</h1>
        <p class="subtitle">{siteDescription}</p>
      </header>

      <main>
        <div class="controls">
          <div class="search-wrap">
            <span class="search-icon">🔍</span>
            <input type="search" id="search" placeholder="جستجو در مقالات..." autocomplete="off" />
          </div>
          <div class="tag-filters">
            <span class="filter-label">فیلتر:</span>
            <button class="tag-btn active" data-tag="همه">همه</button>
            {allTags.map((tag) => (
              <button class="tag-btn" data-tag={tag}>{tag}</button>
            ))}
          </div>
        </div>

        <p class="results-info">
          <span id="visibleCount">{sortedPosts.length}</span> مقاله
        </p>

        <div class="articles-grid" id="articlesGrid">
          {sortedPosts.map((post, i) => (
            <article
              class="article-card"
              data-title={post.data.title}
              data-excerpt={post.data.excerpt}
              data-tags={post.data.tags.join(',')}
              style={`animation-delay: ${i * 60}ms`}
            >
              <div class="card-meta">
                <div class="card-meta-right">
                  <span class="date">📅 {post.data.date}</span>
                  <span class="reading-time">⏱ {post.data.readingTime} دقیقه</span>
                </div>
                <div class="tag-group">
                  {post.data.tags.map((tag) => (
                    <button class="tag" data-filter-tag={tag}>#{tag}</button>
                  ))}
                </div>
              </div>

              <h2>
                <a href={`/posts/${post.id}`}>{post.data.title}</a>
              </h2>
              <p class="excerpt">{post.data.excerpt}</p>
              <a href={`/posts/${post.id}`} class="read-more">ادامه مطلب ←</a>
            </article>
          ))}
        </div>

        <div class="empty-state" id="emptyState">
          <div class="icon">🔍</div>
          <p>مقاله‌ای یافت نشد. عبارت دیگری را امتحان کنید.</p>
        </div>
      </main>

      <footer class="site-footer">
        <p>© {new Date().getFullYear()} تمامی حقوق محفوظ است | {authorName}</p>
        <p>⚡ ساخته شده با Astro و ❤️</p>
      </footer>
    </div>

    <script is:inline>
      // Dark Mode
      const html = document.documentElement;
      const toggle = document.getElementById('darkToggle');
      const icon = document.getElementById('themeIcon');
      const label = document.getElementById('themeLabel');
      function updateUI() {
        const dark = html.classList.contains('dark');
        icon.textContent = dark ? '☀️' : '🌙';
        label.textContent = dark ? 'تم روشن' : 'تم تاریک';
      }
      updateUI();
      toggle.addEventListener('click', () => {
        html.classList.toggle('dark');
        localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        updateUI();
      });

      // Search + Filter
      const searchInput = document.getElementById('search');
      const cards = document.querySelectorAll('.article-card');
      const tagBtns = document.querySelectorAll('.tag-btn');
      const inCardTags = document.querySelectorAll('[data-filter-tag]');
      const visibleCount = document.getElementById('visibleCount');
      const emptyState = document.getElementById('emptyState');
      let activeTag = 'همه', query = '';

      function filter() {
        let count = 0;
        cards.forEach((card) => {
          const q = query.toLowerCase();
          const matchSearch = !q
            || card.dataset.title.toLowerCase().includes(q)
            || card.dataset.excerpt.toLowerCase().includes(q)
            || card.dataset.tags.includes(q);
          const matchTag = activeTag === 'همه' || card.dataset.tags.includes(activeTag);
          card.classList.toggle('hidden', !(matchSearch && matchTag));
          if (matchSearch && matchTag) count++;
        });
        visibleCount.textContent = count;
        emptyState.style.display = count === 0 ? 'block' : 'none';
      }

      searchInput.addEventListener('input', (e) => { query = e.target.value; filter(); });
      tagBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeTag = btn.dataset.tag;
          tagBtns.forEach((b) => b.classList.toggle('active', b.dataset.tag === activeTag));
          filter();
        });
      });
      inCardTags.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeTag = btn.dataset.filterTag;
          tagBtns.forEach((b) => b.classList.toggle('active', b.dataset.tag === activeTag));
          filter();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    </script>
  </body>
</html>