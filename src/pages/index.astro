---
// src/pages/index.astro
import { articles } from '../data/articles.js';

const siteTitle = "وبلاگ شخصی من";
const siteDescription = "مجموعه‌ای از مقالات آموزشی، تجربیات و یادداشت‌های روزانه";
const siteUrl = "https://news-daily-e3a.pages.dev";
const authorName = "علیرضا محمّدی جعفری";
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <link rel="canonical" href={siteUrl} />
    
    <style>
      :root {
        --primary: #4f46e5;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-700: #334155;
        --gray-900: #0f172a;
        --radius: 12px;
        --shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        --shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.1);
        --transition: all 0.3s ease;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Vazir', 'Tahoma', system-ui, sans-serif;
        background: var(--gray-50);
        color: var(--gray-900);
        line-height: 1.8;
        padding: 0 20px;
      }
      .container { max-width: 820px; margin: 0 auto; padding: 30px 0 50px; }
      .site-header {
        text-align: center;
        padding: 40px 0 30px;
        border-bottom: 2px solid var(--gray-200);
        margin-bottom: 40px;
      }
      .site-header h1 {
        font-size: 2.8rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--primary), #7c3aed);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        letter-spacing: -0.5px;
      }
      .site-header .subtitle {
        color: var(--gray-700);
        font-size: 1.1rem;
        margin-top: 6px;
        -webkit-text-fill-color: var(--gray-700);
      }
      .articles-grid {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }
      .article-card {
        background: white;
        border-radius: var(--radius);
        padding: 28px 32px;
        box-shadow: var(--shadow);
        transition: var(--transition);
        border: 1px solid transparent;
      }
      .article-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-hover);
        border-color: var(--gray-200);
      }
      .article-card .meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 12px;
      }
      .article-card .date {
        font-size: 0.85rem;
        color: #64748b;
        background: var(--gray-100);
        padding: 4px 14px;
        border-radius: 20px;
        display: inline-block;
      }
      .article-card .tag-group {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .article-card .tag {
        font-size: 0.75rem;
        font-weight: 500;
        background: #eef2ff;
        color: var(--primary);
        padding: 2px 12px;
        border-radius: 20px;
        transition: var(--transition);
      }
      .article-card .tag:hover {
        background: var(--primary);
        color: white;
      }
      .article-card h2 {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 10px 0 12px;
        line-height: 1.3;
      }
      .article-card h2 a {
        text-decoration: none;
        color: var(--gray-900);
        transition: var(--transition);
      }
      .article-card h2 a:hover {
        color: var(--primary);
      }
      .article-card .excerpt {
        color: #475569;
        font-size: 1rem;
        margin-bottom: 16px;
      }
      .article-card .read-more {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        color: var(--primary);
        text-decoration: none;
        transition: var(--transition);
      }
      .article-card .read-more:hover {
        gap: 12px;
        color: var(--primary-dark);
      }
      .site-footer {
        margin-top: 60px;
        text-align: center;
        padding-top: 25px;
        border-top: 2px solid var(--gray-200);
        color: #94a3b8;
        font-size: 0.9rem;
      }
      @media (max-width: 640px) {
        .site-header h1 { font-size: 2rem; }
        .article-card { padding: 20px; }
        .article-card h2 { font-size: 1.3rem; }
        .article-card .meta { flex-direction: column; align-items: flex-start; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <h1>📝 وبلاگ من</h1>
        <p class="subtitle">{siteDescription}</p>
      </header>
      
      <main>
        <div class="articles-grid">
          {articles.map((article) => (
            <article class="article-card">
              <div class="meta">
                <span class="date">📅 {article.date}</span>
                <div class="tag-group">
                  {article.tags.map((tag) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              </div>
              
              <h2>
                <a href={`/posts/${article.id}`}>{article.title}</a>
              </h2>
              
              <p class="excerpt">{article.excerpt}</p>
              
              <a href={`/posts/${article.id}`} class="read-more">
                ادامه مطلب ←
              </a>
            </article>
          ))}
        </div>
      </main>
      
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} تمامی حقوق محفوظ است | {authorName}</p>
        <p style="margin-top: 6px; font-size: 0.8rem;">
          ⚡ ساخته شده با Astro و ❤️
        </p>
      </footer>
    </div>
  </body>
</html>