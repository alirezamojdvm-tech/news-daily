          </div>
          <div class="form-group">
            <label>سوال شما</label>
            <textarea name="message" placeholder="سوال خود را بنویسید..." required></textarea>
          </div>
          <input type="text" name="_gotcha" style="display:none !important;" />
          <button type="submit" class="btn-submit">🚀 ارسال درخواست</button>
        </form>
        <div id="form-status" class="form-status"></div>
